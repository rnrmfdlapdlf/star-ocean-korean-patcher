<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net48</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><LangVersion>7.3</LangVersion>
    <OutputPath>../bin/Tests/</OutputPath><AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>../src/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/*.cs" Exclude="../src/Program.cs;../src/MainForm.cs;../src/BuildPackage.cs" /><Compile Include="Tests.cs" /><Compile Include="RuntimeTests.cs" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" /><Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>

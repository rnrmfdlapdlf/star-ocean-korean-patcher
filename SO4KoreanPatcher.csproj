<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin/Release/</OutputPath>
    <LangVersion>7.3</LangVersion>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <ApplicationManifest>src/app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/**/*.cs" Exclude="src/Generated/**/*.cs;src/BuildPackage.cs" />
    <Compile Include="src/Generated/BuildInfo.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <Target Name="MakePatchData" BeforeTargets="PrepareForBuild" Condition="'$(UsePreparedPatchData)' != 'true'">
    <MakeDir Directories="$(MSBuildProjectDirectory)\obj;$(MSBuildProjectDirectory)\src\Generated" />
    <Exec Command="&quot;$(WINDIR)\Microsoft.NET\Framework64\v4.0.30319\csc.exe&quot; /nologo /target:exe /platform:x64 /out:obj\BuildPackage.exe /r:System.Web.Extensions.dll /r:System.IO.Compression.dll /r:System.IO.Compression.FileSystem.dll src\BuildPackage.cs" />
    <Exec Command="&quot;$(MSBuildProjectDirectory)\obj\BuildPackage.exe&quot; build &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>
  <Target Name="RequirePreparedPatchData" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('src/Generated/BuildInfo.cs') Or !Exists('bin/Release/SO4KoreanPatch.data')" Text="Patch data must be generated before compilation." />
  </Target>
  <Target Name="PackageRelease" AfterTargets="Build" Condition="'$(CreateReleaseZip)' == 'true'">
    <Exec Command="&quot;$(MSBuildProjectDirectory)\obj\BuildPackage.exe&quot; package &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>
</Project>
